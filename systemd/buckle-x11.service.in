[Unit]
Description=Nostalgia bucklespring keyboard sound (X11 flavour)
Documentation=man:buckle-x11.service(8) man:buckle-x11(1)
# Tie the service to the desktop session rather than to the user manager.
# Where the user has lingering enabled the user manager, and with it
# default.target, stays up from boot to shutdown, so a unit wanted by
# default.target would keep playing to an empty room.  graphical-session.target
# is started by the session at login and stopped at logout, on the local seat
# only, which is what we want here.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=@bindir@/buckle-x11
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session.target
